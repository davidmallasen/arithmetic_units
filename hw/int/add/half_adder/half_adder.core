name: davidmallasen:arithmetic_units:half_adder:1.0.0
description: Half adder module

filesets:
  rtl:
    files:
      - half_adder.sv
    file_type: systemVerilogSource

targets:
  default: &default
    filesets:
      - rtl
    toplevel: half_adder

  sim:
    <<: *default
    flow: sim
    flow_options:
      tool: icarus
      timescale: "1ns/1ps"
      iverilog_options:
        - "-g2012"
      cocotb_module: test.int.add.test_half_adder
