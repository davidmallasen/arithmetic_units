CAPI=2:
# SPDX-FileCopyrightText: 2025 David Mallasén Quintana
# SPDX-License-Identifier: LGPL-3.0-or-later
# Source: https://github.com/davidmallasen/arithmetic_units

name: davidmallasen:arithmetic_units:carry_ripple_adder:1.0.0
description: Carry-ripple adder module

filesets:
  rtl:
    depend:
      - ~davidmallasen:arithmetic_units:full_adder:1.0.0
    files:
      - carry_ripple_adder.sv
    file_type: systemVerilogSource

targets:
  default: &default
    filesets:
      - rtl
    toplevel: carry_ripple_adder

  sim:
    <<: *default
    flow: sim
    flow_options:
      tool: icarus
      timescale: "1ns/1ps"
      iverilog_options:
        - "-g2012"
      cocotb_module: test.int.add.test_carry_ripple_adder
    parameters:
      - N=8

parameters:
  N:
    datatype: int
    paramtype: vlogparam
